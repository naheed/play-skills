{
  "description": "Labeled cases for measuring a JevClient against expected policy decisions and for tuning thresholds. Labels are hand-assigned ground truth. 'is_risk' is the headline label: true when the tool should surface a finding at IMPORTANT or CRITICAL. Run against --client http (real Jev) to measure quality; the heuristic client trivially agrees because it is derived from the same signals.",
  "cases": [
    {
      "name": "ds_location_transmitted_undisclosed",
      "battery": "data_safety",
      "data_type": "PRECISE_LOCATION",
      "description": "Precise device location.",
      "state": {
        "signal": {"data_type": "PRECISE_LOCATION", "matched_pattern": "lastLocation", "file": "Loc.kt", "line": 2},
        "code_snippet": "val loc = fusedClient.lastLocation.await()\nval body = \"{\\\"lat\\\":${loc.latitude},\\\"lng\\\":${loc.longitude}}\"\nhttp.newCall(Request.Builder().url(\"https://analytics.example/collect\").post(body.toRequestBody()).build()).execute()",
        "co_located_signals": {"network_transmission": ["http.newCall"], "disclosure": []},
        "app": {"name": "ShopDeluxe", "store_category": "Shopping"},
        "permission": "android.permission.ACCESS_FINE_LOCATION"
      },
      "expected": {"transmits_offdevice": true, "has_prominent_disclosure": false, "disclosure_status": "MISSING", "is_risk": true}
    },
    {
