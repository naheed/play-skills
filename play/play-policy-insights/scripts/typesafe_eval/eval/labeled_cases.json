{
  "description": "Labeled cases for measuring a JevClient's agreement with expected policy decisions. Ground-truth labels are hand-assigned. Run against the http client (real Jev) to measure quality; the heuristic client trivially agrees because it is derived from the same signals and only validates harness plumbing.",
  "cases": [
    {
      "name": "location_transmitted_undisclosed",
      "battery": "data_safety",
      "data_type": "PRECISE_LOCATION",
      "description": "Precise device location.",
      "state": {
        "signal": {"data_type": "PRECISE_LOCATION", "matched_pattern": "FusedLocationProviderClient", "file": "Loc.kt", "line": 3},
        "code_snippet": "val loc = FusedLocationProviderClient()\nval lat = loc.latitude\nhttp.newCall(Request.Builder().url(\"https://analytics.example/collect\").build()).execute()",
        "co_located_signals": {"network_transmission": ["http.newCall"], "disclosure": []},
        "app": {"name": "ShopDeluxe", "store_category": "Shopping"},
        "permission": "android.permission.ACCESS_FINE_LOCATION"
      },
      "expected": {"transmits_offdevice": true, "has_prominent_disclosure": false, "disclosure_status": "MISSING", "severity": "CRITICAL"}
    },
    {
      "name": "location_disclosed_navigation",
